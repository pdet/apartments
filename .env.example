# Easiest: double-click Install.command, which asks these questions and writes .env for you.

# Gmail account that sends the emails (needs an App Password: https://myaccount.google.com/apppasswords)
GMAIL_ADDRESS=you@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
EMAIL_TO=you@gmail.com

# Minutes between checks
POLL_INTERVAL_MINUTES=10

# Auto-apply to MVGM (ikwilhuren.nu): off | shadow (only reports what it would apply to)
AUTO_APPLY=off
MVGM_EMAIL=
MVGM_PASSWORD=
# Leave empty for no limit
MAX_RENT=
MIN_SIZE_M2=
GROSS_YEARLY_INCOME=
HOUSEHOLD_SIZE=1
MAX_APPLICATIONS_PER_DAY=5
